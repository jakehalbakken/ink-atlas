{
  "name": "ink-atlas",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Ink Atlas: iPad-first 3D tattoo placement studio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "mesh": "python3 -I tools/mesh.py data-src src/body.js",
    "icons": "node tools/icons.mjs",
    "shot": "node tools/shot.mjs",
    "uv": "python3 -I tools/uv.py data-src src/body-uv.js",
    "build:accounts-test": "VITE_SUPABASE_URL=http://127.0.0.1:54329 VITE_SUPABASE_ANON_KEY=test-anon-key-for-the-fake-supabase VITE_SUPABASE_EMAIL_CODES=1 vite build --outDir ../dist-accounts --emptyOutDir"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@supabase/supabase-js": "2.119.0",
    "mp4-muxer": "^5.2.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "puppeteer-core": "^25.17.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
